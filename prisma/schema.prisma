// The shell's own data layer. This is the platform's database, not Base44's —
// the apps users build have their own entities, over in Base44.
//
// Conventions:
//   * Prisma fields are camelCase; columns are snake_case via @map. The wire
//     contract is Base44-shaped (snake_case, created_date/updated_date), and that
//     translation lives in one place — src/lib/entities.ts — never here.
//   * `createdBy` is the owner email and the RLS predicate. Every user-owned
//     model has it, indexed, and is only ever queried through scopedWhere()
//     in src/lib/rls.ts. Never query these models raw.
//   * ids are opaque strings, so Base44's Mongo ObjectId hex values can be
//     carried over verbatim and boardId/groupId refs stay intact.

generator client {
  provider      = "prisma-client-js"
  // Netlify builds on Ubuntu but runs functions on Amazon Linux; without the
  // rhel target the query engine is missing at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // url = pooled connection (app runtime); directUrl = unpooled (migrations).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  admin
}

enum BoardVisibility {
  private
  shared
}

enum BoardViewType {
  table
  kanban
}

enum ItemPriority {
  low
  medium
  high
  critical
}

/// `delisted` is kept rather than deleted so anyone already running the app keeps
/// working: pulling a listing is about discovery, not about breaking its users.
enum ListingStatus {
  draft
  published
  delisted
}

enum Base44LinkStatus {
  pending
  linked
}

/// Shell users. Created/upserted on Google sign-in, matched by email — which is
/// what lets the email-keyed AppOwnership and Base44Link rows exist before their
/// owner has ever signed in here.
/// `role` is a manual DB flag: flip to `admin` by hand. It grants no RLS bypass —
/// see src/lib/rls.ts.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  fullName  String?  @map("full_name")
  imageUrl  String?  @map("image_url")
  role      Role     @default(user)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Board columns and groups stay denormalized JSON, exactly as in Base44:
///   columns: [{ id, title, type, width, options }]
///   groups:  [{ id, title, color, collapsed, visible_columns[], custom_columns[] }]
/// Groups are not a table — Item.groupId is a free string pointing into this JSON,
/// so it has no FK. Column `type` values: text | status | date | people | number |
/// budget | priority | checkbox | dropdown.
model Board {
  id          String          @id @default(cuid())
  title       String
  description String?
  color       String          @default("#0073EA")
  visibility  BoardVisibility @default(private)
  viewType    BoardViewType   @default(table) @map("view_type")
  columns     Json            @default("[]")
  groups      Json            @default("[]")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[]

  @@index([createdBy])
  @@map("boards")
}

model Item {
  id          String       @id @default(cuid())
  title       String
  description String?
  orderIndex  Float?       @map("order_index")
  /// Dynamic column data, keyed by column ID (not column title).
  data        Json         @default("{}")
  priority    ItemPriority @default(medium)
  color       String?

  boardId String  @map("board_id")
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Points at a Board.groups[].id. Intentionally unconstrained — groups live in JSON.
  groupId String? @map("group_id")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@index([boardId, orderIndex])
  @@map("items")
}

/// A Base44 app pinned to a user's dashboard.
model Widget {
  id                   String  @id @default(cuid())
  appId                String  @map("app_id")
  appName              String  @map("app_name")
  appSlug              String? @map("app_slug")
  previewUrl           String? @map("preview_url")
  previewScreenshotUrl String? @map("preview_screenshot_url")
  orderIndex           Float   @default(0) @map("order_index")
  height               Int     @default(320)
  /// 1 = half width, 2 = full width.
  colSpan              Int     @default(1) @map("col_span")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdBy, orderIndex])
  @@map("widgets")
}

/// Register of which shell user owns which Base44 app. One row per (app, owner).
model AppOwnership {
  id      String  @id @default(cuid())
  appId   String  @map("app_id")
  /// Display name at creation time — debugging only, may be stale.
  appName String? @map("app_name")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([appId, createdBy])
  @@index([createdBy])
  @@map("app_ownerships")
}

/// Per-user Base44 platform credentials (service principal + minted token).
/// SECRET-BEARING: must never reach the client. Reached only from server code via
/// src/lib/base44Link.ts, keyed by email — never through the generic entity CRUD,
/// which refuses this entity outright.
model Base44Link {
  id String @id @default(cuid())

  /// The shell user this link belongs to. Lookup key.
  appUserEmail String @unique @map("app_user_email")

  /// This user's Base44 *service principal* id — opaque, stable, and
  /// deliberately NOT an email: Base44 derives a non-routable synthetic address
  /// from it, so putting a real address here would be the impersonation vector
  /// the synthetic-principal design exists to remove. Derived deterministically
  /// (see principalId() in src/lib/base44Link.ts), so deleting this row and
  /// reconnecting lands on the SAME principal rather than orphaning the apps it
  /// owns. Persisted anyway, because it is the only thing that maps a Base44
  /// workspace member back to a Sunny user.
  serviceExternalId String? @unique @map("service_external_id")

  status       Base44LinkStatus @default(pending)
  accessToken  String?          @map("access_token")
  /// Kept only so `disconnect` can revoke it — the bridge re-mints on expiry
  /// rather than running a refresh exchange.
  refreshToken String?          @map("refresh_token")
  /// Now ~1h out, not ~30d: vended principal tokens are minted short-lived.
  expiresAt    DateTime?        @map("expires_at")

  organizationId       String? @map("organization_id")
  /// The principal's synthetic Base44 address
  /// (`{slug}-{hash}@{org}.svc.base44.invalid`). Non-routable, debug only —
  /// never the user's real email, which is why it is safe to store here.
  base44UserEmail      String? @map("base44_user_email")
  /// True once POST /api/service/users has returned for this principal. A row
  /// that predates provisioning stays false and needs one reconnect.
  principalProvisioned Boolean @default(false) @map("principal_provisioned")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@map("base44_links")
}


/// An app its author has offered to other Sunny users.
///
/// The one model whose reads are not owner-scoped: a published listing is public by
/// intent. Writes stay owner-only, and src/lib/marketplace.ts is the only module that
/// touches it — a documented carve-out from scopedWhere, not a precedent.
///
/// The `app*` fields are snapshotted at publish time because an installer's Base44
/// principal cannot see another user's app to resolve them later, which is also why
/// publishing requires a deployed app.
model MarketplaceListing {
  id String @id @default(cuid())

  /// The Base44 app on offer. One listing per app.
  appId String @unique @map("app_id")

  title       String
  tagline     String?
  category    String?

  /// Snapshot. `appUrl` is the resolved embed URL rather than something derived from
  /// `appSlug` at render time, because the published host still rotates.
  appSlug       String? @map("app_slug")
  appUrl        String? @map("app_url")
  screenshotUrl String? @map("screenshot_url")

  status      ListingStatus @default(draft)
  publishedAt DateTime?     @map("published_at")

  /// The author. Writes are scoped to this; reads of a published row are not.
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@index([status])
  @@map("marketplace_listings")
}


/// An app a user has installed. This is the grant: `/api/sunny/token` mints for an app
/// you installed or authored, and deleting the row revokes on the next call.
///
/// It used to be the `Widget` row, which welded "I want this app" to "I want it on my
/// home page". SENSITIVE like Base44Link — reached only through src/lib/appInstall.ts,
/// never the generic entity CRUD.
model AppInstall {
  id String @id @default(cuid())

  /// The Base44 app. Not an FK — apps live in Base44, not here.
  appId String @map("app_id")
  /// Display name at install time. The installs list and debugging; may be stale.
  appName String? @map("app_name")

  /// The installer, and therefore whose rows this install reaches.
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([appId, createdBy])
  @@index([createdBy])
  @@map("app_installs")
}

enum Base44AppLifecycle {
  active
  /// Deleted in Base44 = moved to trash, self-serve restorable for 30 days.
  /// Deliberately not `deleted`: naming it that invites a purge, and a purge is
  /// wrong for every app that comes back via app.restored.v1.
  trashed
}

/// Every inbound Base44 webhook we accepted. Written by
/// src/app/api/base44/webhooks/route.ts and nothing else.
///
/// Delivery is at-least-once: Base44 retries any non-2xx up to 8 times over
/// ~27h, and a delivery whose response was lost in flight arrives again with the
/// same CloudEvents id. The unique index on `cloudEventId` is what makes
/// reprocessing a no-op, so it is the de-duplication mechanism rather than a
/// diagnostic — see the note in the route.
model Base44WebhookEvent {
  id String @id @default(cuid())

  /// The CloudEvents `id`, also sent as the `webhook-id` header and covered by
  /// the signature. Unique: this is the dedupe key.
  cloudEventId String @unique @map("cloud_event_id")

  eventType String  @map("event_type")
  /// Null for webhook.test.v1, which is about the endpoint, not an app.
  appId     String? @map("app_id")
  /// The Base44 workspace the event came from; asserted against BASE44_ORG_ID.
  workspaceId String @map("workspace_id")

  receivedAt  DateTime  @default(now()) @map("received_at")
  /// Set once the reconciler has run. A row with this null is an event we
  /// accepted and then failed to project — the signal worth alerting on.
  processedAt DateTime? @map("processed_at")

  @@index([eventType, receivedAt])
  @@map("base44_webhook_events")
}

/// What the webhooks say is true of each Base44 app, projected out of the event
/// stream. One row per app.
///
/// This exists because the shell cannot learn some of it any other way:
/// `listApps` is a poll, it costs a round trip per page load, and it cannot
/// report a deletion at all — a trashed app simply stops being listed, which is
/// indistinguishable from a failed call. Events carry the transition.
model Base44AppState {
  id String @id @default(cuid())

  /// The Base44 app. Not an FK — apps live in Base44, not here.
  appId String @unique @map("app_id")

  lifecycle Base44AppLifecycle @default(active)

  /// The shell user who owns the app, resolved from the event's
  /// `owner_service_external_id` via Base44Link. Null when the owning principal
  /// is not one of ours — an app built by another tool in the same workspace —
  /// which is a legitimate state, not an error.
  ownerEmail String? @map("owner_email")

  /// Last published version identity, from app.published.v1. Null until first
  /// publish, and left in place by an unpublish so "what was live" survives.
  publishedVersion String?   @map("published_version")
  publishedAt      DateTime? @map("published_at")
  unpublishedAt    DateTime? @map("unpublished_at")

  /// `time` from the newest event applied. Used to drop stale events: retries
  /// mean a slow attempt 3 can land after a fresh attempt 1 for a later event,
  /// and applying it would move the app backwards in time.
  lastEventAt DateTime @map("last_event_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerEmail])
  @@map("base44_app_states")
}
