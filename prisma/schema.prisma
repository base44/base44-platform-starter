// The shell's own data layer. This is the platform's database, not Base44's —
// the apps users build have their own entities, over in Base44.
//
// Conventions:
//   * Prisma fields are camelCase; columns are snake_case via @map. The wire
//     contract is Base44-shaped (snake_case, created_date/updated_date), and that
//     translation lives in one place — src/lib/entities.ts — never here.
//   * `createdBy` is the owner email and the RLS predicate. Every user-owned
//     model has it, indexed, and is only ever queried through scopedWhere()
//     in src/lib/rls.ts. Never query these models raw.
//   * ids are opaque strings, so Base44's Mongo ObjectId hex values can be
//     carried over verbatim and boardId/groupId refs stay intact.

generator client {
  provider      = "prisma-client-js"
  // Netlify builds on Ubuntu but runs functions on Amazon Linux; without the
  // rhel target the query engine is missing at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // url = pooled connection (app runtime); directUrl = unpooled (migrations).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  admin
}

enum BoardVisibility {
  private
  shared
}

enum BoardViewType {
  table
  kanban
}

enum ItemPriority {
  low
  medium
  high
  critical
}

/// `delisted` is kept rather than deleted so anyone already running the app keeps
/// working: pulling a listing is about discovery, not about breaking its users.
enum ListingStatus {
  draft
  published
  delisted
}

/// Shell users. Created/upserted on Google sign-in, matched by email — which is
/// what lets the email-keyed AppOwnership rows exist before their owner has ever
/// signed in here.
/// `role` is a manual DB flag: flip to `admin` by hand. It grants no RLS bypass —
/// see src/lib/rls.ts.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  fullName  String?  @map("full_name")
  imageUrl  String?  @map("image_url")
  role      Role     @default(user)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Board columns and groups stay denormalized JSON, exactly as in Base44:
///   columns: [{ id, title, type, width, options }]
///   groups:  [{ id, title, color, collapsed, visible_columns[], custom_columns[] }]
/// Groups are not a table — Item.groupId is a free string pointing into this JSON,
/// so it has no FK. Column `type` values: text | status | date | people | number |
/// budget | priority | checkbox | dropdown.
model Board {
  id          String          @id @default(cuid())
  title       String
  description String?
  color       String          @default("#0073EA")
  visibility  BoardVisibility @default(private)
  viewType    BoardViewType   @default(table) @map("view_type")
  columns     Json            @default("[]")
  groups      Json            @default("[]")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items Item[]

  @@index([createdBy])
  @@map("boards")
}

model Item {
  id          String       @id @default(cuid())
  title       String
  description String?
  orderIndex  Float?       @map("order_index")
  /// Dynamic column data, keyed by column ID (not column title).
  data        Json         @default("{}")
  priority    ItemPriority @default(medium)
  color       String?

  boardId String  @map("board_id")
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Points at a Board.groups[].id. Intentionally unconstrained — groups live in JSON.
  groupId String? @map("group_id")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@index([boardId, orderIndex])
  @@map("items")
}

/// A Base44 app pinned to a user's dashboard.
model Widget {
  id                   String  @id @default(cuid())
  appId                String  @map("app_id")
  appName              String  @map("app_name")
  appSlug              String? @map("app_slug")
  previewUrl           String? @map("preview_url")
  previewScreenshotUrl String? @map("preview_screenshot_url")
  orderIndex           Float   @default(0) @map("order_index")
  height               Int     @default(320)
  /// 1 = half width, 2 = full width.
  colSpan              Int     @default(1) @map("col_span")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdBy, orderIndex])
  @@map("widgets")
}

/// Register of which shell user owns which Base44 app. One row per (app, owner).
///
/// Every app lives in the one Base44 account the integration authenticates with,
/// so Base44 itself has no idea which shell user built what — this row is the only
/// record, and the platform proxy refuses app-scoped calls without it. Written by
/// the proxy when it creates an app; a client can read and delete its own rows but
/// never create one (src/lib/entities.ts), or it could claim another builder's app.
/// `src/lib/appOwnership.ts` is the module that answers "is this app theirs".
model AppOwnership {
  id      String  @id @default(cuid())
  appId   String  @map("app_id")
  /// Display name at creation time — debugging only, may be stale.
  appName String? @map("app_name")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([appId, createdBy])
  @@index([createdBy])
  @@map("app_ownerships")
}

/// An app its author has offered to other Sunny users.
///
/// The one model whose reads are not owner-scoped: a published listing is public by
/// intent. Writes stay owner-only, and src/lib/marketplace.ts is the only module that
/// touches it — a documented carve-out from scopedWhere, not a precedent.
///
/// The `app*` fields are snapshotted at publish time because the platform proxy answers
/// only to an app's author, so an installer cannot resolve them later, which is also why
/// publishing requires a deployed app.
model MarketplaceListing {
  id String @id @default(cuid())

  /// The Base44 app on offer. One listing per app.
  appId String @unique @map("app_id")

  title       String
  tagline     String?
  category    String?

  /// Snapshot. `appUrl` is the resolved embed URL rather than something derived from
  /// `appSlug` at render time, because the published host still rotates.
  appSlug       String? @map("app_slug")
  appUrl        String? @map("app_url")
  screenshotUrl String? @map("screenshot_url")

  status      ListingStatus @default(draft)
  publishedAt DateTime?     @map("published_at")

  /// The author. Writes are scoped to this; reads of a published row are not.
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdBy])
  @@index([status])
  @@map("marketplace_listings")
}


/// An app a user has installed. This is the grant: `/api/sunny/token` mints for an app
/// you installed or authored, and deleting the row revokes on the next call.
///
/// It used to be the `Widget` row, which welded "I want this app" to "I want it on my
/// home page". SENSITIVE — reached only through src/lib/appInstall.ts,
/// never the generic entity CRUD.
model AppInstall {
  id String @id @default(cuid())

  /// The Base44 app. Not an FK — apps live in Base44, not here.
  appId String @map("app_id")
  /// Display name at install time. The installs list and debugging; may be stale.
  appName String? @map("app_name")

  /// The installer, and therefore whose rows this install reaches.
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([appId, createdBy])
  @@index([createdBy])
  @@map("app_installs")
}
