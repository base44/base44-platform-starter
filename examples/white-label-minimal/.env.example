# Workspace API key (b44k_) of your white-label workspace, with Full access. It
# authenticates every call, as the workspace owner: building, live updates and previews.
BASE44_WORKSPACE_API_KEY=
BASE44_WORKSPACE_ID=
# Set to your Base44 HTTPS origin.
BASE44_PLATFORM_HOST=
# Optional: the workspace owner's email. When set, only the apps it created are listed.
BASE44_ACCOUNT_EMAIL=
