NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=
DIRECT_URL=
# Personal access token of the integration account, created in your enterprise
# workspace with access to all apps and full permission.
BASE44_ACCESS_TOKEN=
BASE44_WORKSPACE_ID=
# Workspace API key for live updates (apps:watch) and for signing builders into
# their latest build (Provision app users, Mint embed sign-in tokens).
BASE44_SVC_KEY=
# Set to your Base44 HTTPS origin.
BASE44_PLATFORM_HOST=
# Set NEXTAUTH_URL explicitly, including in local development.
NEXTAUTH_URL=http://127.0.0.1:3001
# Optional: use Sunny's existing OAuth callback with a shared NEXTAUTH_SECRET.
AUTH_REDIRECT_PROXY_URL=

# Set to true to show the lean rewrite (lean/) instead of the classic Tiny Sunny. It needs:
TINY_SUNNY_LEAN=
# The account behind BASE44_ACCESS_TOKEN; the lean app lists only the apps it created.
BASE44_ACCOUNT_EMAIL=
