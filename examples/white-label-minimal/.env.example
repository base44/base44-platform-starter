# Personal access token of the account your integration builds as, created in your white-label
# workspace with All apps and Full access. It authenticates every call: building, live updates
# and previews. A workspace API key (b44k_) with Full access works too, as BASE44_WORKSPACE_API_KEY.
BASE44_ACCESS_TOKEN=
BASE44_WORKSPACE_ID=
# Set to your Base44 HTTPS origin.
BASE44_PLATFORM_HOST=
# Optional: the email of the account that owns the token. When set, only the apps it created are listed.
BASE44_ACCOUNT_EMAIL=
