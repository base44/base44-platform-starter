# Personal access token of the integration account, created in your enterprise
# workspace with access to all apps and full permission.
BASE44_ACCESS_TOKEN=
BASE44_WORKSPACE_ID=
# Workspace API key for live updates (apps:watch) and previews (Provision app users,
# Mint embed sign-in tokens).
BASE44_SVC_KEY=
# Set to your Base44 HTTPS origin.
BASE44_PLATFORM_HOST=
# Optional: the account behind BASE44_ACCESS_TOKEN. When set, only the apps it created are listed.
BASE44_ACCOUNT_EMAIL=
