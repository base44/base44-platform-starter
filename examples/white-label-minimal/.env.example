NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=
DIRECT_URL=
# Personal access token of the integration account, created in your enterprise
# workspace with access to all apps and full permission.
BASE44_ACCESS_TOKEN=
BASE44_WORKSPACE_ID=
# Workspace API key with the apps:watch scope, used only to open live-update sessions.
BASE44_SVC_KEY=
# Set to your Base44 HTTPS origin.
BASE44_PLATFORM_HOST=
# Set NEXTAUTH_URL explicitly, including in local development.
NEXTAUTH_URL=http://127.0.0.1:3001
# Exact HTTPS origin in production; leave empty for localhost.
BUILDER_ORIGIN=
# Optional: use Sunny's existing OAuth callback with a shared NEXTAUTH_SECRET.
AUTH_REDIRECT_PROXY_URL=

# Static preview hosting domain; confirm for your Base44 environment.
BASE44_STATIC_PREVIEW_DOMAIN=
