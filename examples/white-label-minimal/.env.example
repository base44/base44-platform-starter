# Personal access token of the integration account, created in your white-label
# workspace (Builder plan or higher) with access to all apps and Full access. It
# authenticates every call: building, live updates and previews.
BASE44_ACCESS_TOKEN=
BASE44_WORKSPACE_ID=
# Set to your Base44 HTTPS origin.
BASE44_PLATFORM_HOST=
# Optional: the account behind BASE44_ACCESS_TOKEN. When set, only the apps it created are listed.
BASE44_ACCOUNT_EMAIL=
