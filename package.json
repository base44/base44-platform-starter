    "db:studio": "prisma studio",
    "rls:smoke": "tsx --env-file=.env scripts/rls-smoke.ts",
    "auth:smoke": "tsx --env-file=.env scripts/auth-smoke.ts",
    "entities:smoke": "tsx --env-file=.env scripts/entity-api-smoke.ts",
    "sunny:smoke": "tsx --env-file=.env scripts/sunny-api-smoke.ts",
    "base44:smoke": "tsx --env-file=.env scripts/base44-smoke.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
