    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.2.8",
    "react-markdown": "^9.0.1",
    "tailwind-merge": "^3.0.2",
    "tsx": "^4.23.5",
    "tw-animate-css": "^1.4.0"
